{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-prompt-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-prompt-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --dir src",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "catalog:publish": "node scripts/publish-exercise-catalog.mjs",
    "check:leak": "node scripts/check-no-reference-leak.mjs",
    "check:rules-version": "node scripts/check-rules-version.mjs",
    "report:billing-size": "node scripts/billing-size-report.mjs",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "e2e:account": "node e2e/account.mjs",
    "e2e:mensalidades": "node e2e/mensalidades.mjs",
    "e2e:admin-focus": "node e2e/admin-focus.mjs",
    "e2e:ficha-privacy": "node e2e/ficha-privacy.mjs",
    "e2e:fichas": "node e2e/fichas.mjs",
    "test:rules": "npm --prefix ../functions run build && firebase emulators:exec --config ../firebase.json --project demo-personal-tracker --only auth,firestore,functions,storage \"vitest run --dir rules --testTimeout=30000 --no-file-parallelism\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.2",
    "uuid": "^14.0.2",
    "@opentelemetry/core": "^2.8.0"
  }
}
