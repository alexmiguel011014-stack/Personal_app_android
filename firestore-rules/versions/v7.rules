// Rules version: 7
rules_version = '2';

// Schema (see GOALS.md §4a, §7):
//   users/{uid}          - role ('ADM'|'TRAINER'|'STUDENT'), trainerId (STUDENT docs only).
//                           A linked STUDENT's full profile lives here (GOALS.md §7 "unify").
//   students/{studentId} - trainerId. Trainer-authored draft, pre-invite only.
//   invites/{code}        - trainerId, used, createdAt + copied draft fields.
//   workouts/{workoutId} - trainerId, studentId, status ('draft'|'assigned')
//   biometrics/{entryId} - trainerId, studentId
//   schedules/{scheduleId} - trainerId, studentId
//   workoutLogs/{logId}  - trainerId, studentId (written by the student, read by their trainer)
//   assessments/{id}     - trainerId, studentId, submittedAt, parQAnswersJson, goal, ... (GOALS.md
//                           §17: written by the student, append-only, read by their trainer)
//   trainerRequests/{uid} - email, createdAt. Self-written "please promote me" mailbox, doc ID is
//                           the requester's own uid; only an ADM can read/act on it (GOALS.md §5e).
//   payments/{studentId}_{YYYY-MM} - one monthly charge (GOALS.md §23c). Trainer-only.
//   billingPlans/{studentId}       - what to charge that student each month (GOALS.md §23c).
//                                    Trainer-only.
//
//   users/{uid} also carries the GOALS.md §17 flags a trainer grants a linked student:
//   canSelfAssess, canLogBiometrics (trainer-only), pendingAssessmentRequest (set by the trainer,
//   cleared by the student's assessment batch), lastAssessmentId (that batch's link). Web-only
//   flag, same rule: canAddSets — whether the student may add extra sets when logging a session
//   (off unless the trainer turns it on; a missing field reads as off).
//
//   appData/exerciseCatalog - the trainer's exercise reference, which the web's ficha editor reads to fill each
//                           exercise's muscles (GOALS.md §33). Never a public file: only an approved, active
//                           trainer and the ADM can get it; the ADM alone writes it.
//
//   Verified e-mail (GOALS.md §27): claiming an invite (creating or re-claiming users/{uid}) and
//   queueing trainerRequests/{uid} need request.auth.token.email_verified — see hasVerifiedEmail().

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function field(data, name) {
      return data.get(name, null);
    }

    function myRole() {
      return field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'role');
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'ADM';
    }

    // GOALS.md §27: the caller's address was confirmed by the link Firebase mailed to it. Firebase
    // only checks an address's shape, so without this an invented or mistyped one (teste@teste.com)
    // could become a student. Read from the ID token — no document read, so it costs nothing against
    // the per-request get() limit — and required only at the entry doors (claiming an invite,
    // queueing a trainer request): accounts that already have a profile keep working as they are.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function trainerBillingIsCurrent(user) {
      let status = field(user, 'platformBillingStatus');
      let until = field(user, 'platformBillingUntil');
      return (status == null && until == null) ||
        ((status == 'trial' || status == 'current') &&
          (until == null || (until is int && until > request.time.toMillis())));
    }

    // Missing expiry remains valid for legacy invites; malformed values fail closed.
    // An invite that can still be claimed, apart from the draft's pause (inviteCanBeClaimed adds that).
    function inviteIsLive(invite) {
      let expiresAt = field(invite, 'expiresAt');
      return field(invite, 'used') == false &&
        field(invite, 'cancelledAt') == null && field(invite, 'revokedAt') == null &&
        (expiresAt == null || (expiresAt is int && expiresAt > request.time.toMillis()));
    }

    // The account that claimed this code (users/{uid}.inviteCode, written in the same transaction).
    function isInviteClaimant(code) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && field(get(userPath).data, 'inviteCode') == code;
    }

    function inviteCanBeClaimed(invite) {
      let expiresAt = field(invite, 'expiresAt');
      return field(invite, 'used') == false &&
        field(invite, 'cancelledAt') == null && field(invite, 'revokedAt') == null &&
        (expiresAt == null || (expiresAt is int && expiresAt > request.time.toMillis())) &&
        inviteDraftAllowsClaim(invite);
    }

    function draftAllowsInviteClaim(draft) {
      let paused = field(draft, 'paused');
      return paused == null || paused == false;
    }

    // Check eligibility inside Rules without granting the invitee read access to the full draft.
    function inviteDraftAllowsClaim(invite) {
      let draftId = field(invite, 'draftId');
      let draftPath = /databases/$(database)/documents/students/$(draftId);
      return !(draftId is string && exists(draftPath)) ||
        draftAllowsInviteClaim(get(draftPath).data);
    }

    function hasValidPauseFlag(data) {
      return !data.keys().hasAny(['paused']) || data.paused is bool;
    }

    function isNotSelfPaused(data) {
      let paused = field(data, 'paused');
      return paused == null || paused == false;
    }

    // v5: a user may correct their own name once every 60 days (the web account page). The change must carry
    // nameChangedAt equal to the request's own time — server time, so a device clock decides nothing — and the
    // previous stamp must be missing or at least 60 days old. Without a rename the stamp cannot move, and a rename
    // cannot omit it. The owning trainer's edit of a linked student's name is another rule and neither uses nor
    // resets this stamp.
    function validSelfNameChange() {
      let nameBefore = field(resource.data, 'name');
      let nameAfter = field(request.resource.data, 'name');
      let stampBefore = field(resource.data, 'nameChangedAt');
      let stampAfter = field(request.resource.data, 'nameChangedAt');
      return (nameAfter == nameBefore && stampAfter == stampBefore) || (
        nameAfter is string && nameAfter != nameBefore &&
        nameAfter.size() >= 2 && nameAfter.size() <= 80 && nameAfter == nameAfter.trim() &&
        nameAfter.matches('[^\\x00-\\x1f\\x7f]+') &&
        stampAfter == request.time &&
        (stampBefore == null || request.time >= stampBefore + duration.value(60, 'd'))
      );
    }

    function validSelfProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'name', 'nameChangedAt', 'gender', 'phone', 'goal', 'experienceLevel', 'medicalNotes', 'trainingDays',
          'email', 'avatarStoragePath', 'pendingAssessmentRequest', 'lastAssessmentId'
        ]) &&
        validSelfNameChange() &&
        field(request.resource.data, 'role') == field(resource.data, 'role') &&
        field(request.resource.data, 'trainerId') == field(resource.data, 'trainerId') &&
        field(request.resource.data, 'paused') == field(resource.data, 'paused') &&
        field(request.resource.data, 'canSelfAssess') == field(resource.data, 'canSelfAssess') &&
        field(request.resource.data, 'canLogBiometrics') == field(resource.data, 'canLogBiometrics') &&
        field(request.resource.data, 'canAddSets') == field(resource.data, 'canAddSets') &&
        field(request.resource.data, 'accessStatus') == field(resource.data, 'accessStatus') &&
        field(request.resource.data, 'suspendedAt') == field(resource.data, 'suspendedAt') &&
        field(request.resource.data, 'suspendedReason') == field(resource.data, 'suspendedReason') &&
        field(request.resource.data, 'createdBy') == field(resource.data, 'createdBy') &&
        field(request.resource.data, 'plan') == field(resource.data, 'plan') &&
        field(request.resource.data, 'platformBillingStatus') == field(resource.data, 'platformBillingStatus') &&
        field(request.resource.data, 'platformBillingUntil') == field(resource.data, 'platformBillingUntil') &&
        field(request.resource.data, 'inviteCode') == field(resource.data, 'inviteCode') &&
        field(request.resource.data, 'createdAt') == field(resource.data, 'createdAt') &&
        (field(request.resource.data, 'email') == field(resource.data, 'email') ||
          (hasVerifiedEmail() && field(request.resource.data, 'email') == request.auth.token.get('email', null))) &&
        (field(request.resource.data, 'avatarStoragePath') == field(resource.data, 'avatarStoragePath') ||
          field(request.resource.data, 'avatarStoragePath') == null ||
          field(request.resource.data, 'avatarStoragePath') == 'account-avatars/' + uid + '/profile') &&
        (
          field(request.resource.data, 'pendingAssessmentRequest') == field(resource.data, 'pendingAssessmentRequest') ||
          (
            field(resource.data, 'pendingAssessmentRequest') == true &&
            field(request.resource.data, 'pendingAssessmentRequest') == false &&
            !exists(/databases/$(database)/documents/assessments/$(request.resource.data.lastAssessmentId)) &&
            existsAfter(/databases/$(database)/documents/assessments/$(request.resource.data.lastAssessmentId))
          )
        );
    }

    function validBillingAuditForUser(uid, fromStatus, fromUntil, userAfter) {
      let auditId = field(userAfter, 'lastAuditId');
      let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
      let auditAfter = getAfter(auditPath);
      return auditId is string && !exists(auditPath) && existsAfter(auditPath) &&
        field(auditAfter.data, 'adminUid') == request.auth.uid &&
        field(auditAfter.data, 'targetUid') == uid &&
        field(auditAfter.data, 'action') in [
          'trainer.create', 'trainer.promote', 'subscription.assign', 'trial.extend',
          'invoice.issue', 'invoice.payment', 'invoice.extend',
          'payment.record', 'payment.void'
        ] &&
        field(auditAfter.data, 'billingFromStatus') == fromStatus &&
        field(auditAfter.data, 'billingFromUntil') == fromUntil &&
        field(auditAfter.data, 'billingToStatus') == field(userAfter, 'platformBillingStatus') &&
        field(auditAfter.data, 'billingToUntil') == field(userAfter, 'platformBillingUntil');
    }

    function validWebsiteInviteRevision(trainerId, code, action) {
      let statePath = /databases/$(database)/documents/platformInviteState/$(trainerId);
      let stateBefore = get(statePath);
      let stateAfter = getAfter(statePath);
      let oldRevision = exists(statePath) ? field(stateBefore.data, 'revision') : 0;
      return existsAfter(statePath) &&
        field(stateAfter.data, 'trainerId') == trainerId &&
        field(stateAfter.data, 'revision') is int &&
        ((!exists(statePath) && field(stateAfter.data, 'revision') == 1) ||
          (exists(statePath) && oldRevision is int && field(stateAfter.data, 'revision') == oldRevision + 1)) &&
        field(stateAfter.data, 'lastCode') == code &&
        field(stateAfter.data, 'lastAction') == action &&
        field(stateAfter.data, 'updatedAt') is int;
    }

    // The caller is the TRAINER who owns this record.
    function isOwningTrainer(trainerId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && request.auth.uid == trainerId &&
        field(user, 'role') == 'TRAINER' && field(user, 'accessStatus') != 'suspended' &&
        trainerBillingIsCurrent(user);
    }

    // Resolve a student's owner from the linked profile first. A draft is only authoritative
    // before the profile exists; a wrong existing profile must never fall back to a matching draft.
    function studentIsLinkedToTrainer(trainerId, studentId) {
      return trainerId is string && studentId is string &&
        ((exists(/databases/$(database)/documents/users/$(studentId)) &&
            field(get(/databases/$(database)/documents/users/$(studentId)).data, 'role') == 'STUDENT' &&
            field(get(/databases/$(database)/documents/users/$(studentId)).data, 'trainerId') == trainerId) ||
          (!exists(/databases/$(database)/documents/users/$(studentId)) &&
            exists(/databases/$(database)/documents/students/$(studentId)) &&
            field(get(/databases/$(database)/documents/students/$(studentId)).data, 'trainerId') == trainerId));
    }

    function canReceiveRecoveryDraft(trainerUid) {
      let trainerPath = /databases/$(database)/documents/users/$(trainerUid);
      let subscriptionPath = /databases/$(database)/documents/platformSubscriptions/$(trainerUid);
      return exists(trainerPath) && exists(subscriptionPath) &&
        field(get(trainerPath).data, 'role') == 'TRAINER' &&
        field(get(trainerPath).data, 'accessStatus') != 'suspended' &&
        field(get(trainerPath).data, 'suspendedAt') == null &&
        field(get(subscriptionPath).data, 'trainerUid') == trainerUid &&
        field(get(subscriptionPath).data, 'mode') in ['paid', 'trial'] &&
        field(get(trainerPath).data, 'platformBillingStatus') in ['current', 'trial'] &&
        (field(get(trainerPath).data, 'platformBillingUntil') == null ||
          (field(get(trainerPath).data, 'platformBillingUntil') is int &&
            field(get(trainerPath).data, 'platformBillingUntil') > request.time.toMillis())) &&
        ((field(get(subscriptionPath).data, 'mode') == 'paid' &&
            field(get(trainerPath).data, 'platformBillingStatus') == 'current') ||
          (field(get(subscriptionPath).data, 'mode') == 'trial' &&
            field(get(trainerPath).data, 'platformBillingStatus') == 'trial' &&
            field(get(subscriptionPath).data, 'trialEndsAt') is int &&
            field(get(subscriptionPath).data, 'trialEndsAt') > request.time.toMillis()));
    }

    // GOALS.md §23d: a student's own write can never result in a §17 permission their trainer
    // didn't grant. The self-update branch already froze these flags, but the invite claim (a
    // create, or the re-claim update) could arrive with them switched on.
    function grantsNoPermissions(data) {
      return data.get('canSelfAssess', false) == false &&
        data.get('canLogBiometrics', false) == false &&
        data.get('canAddSets', false) == false &&
        data.get('pendingAssessmentRequest', false) == false;
    }

    // users/{uid} — self-read, admin-managed writes. A user can edit their own
    // profile fields but can never change their own role or trainerId (no self-promotion).
    match /users/{uid} {
      function validAdminBillingUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isAdmin() && request.auth.uid != uid &&
          (!changed.hasAny(['platformBillingStatus', 'platformBillingUntil', 'lastAuditId']) ||
            validBillingAuditForUser(
              uid,
              field(resource.data, 'platformBillingStatus'),
              field(resource.data, 'platformBillingUntil'),
              request.resource.data
            ));
      }

      // The owning trainer may also list/read their own linked students' docs (GOALS.md §13d
      // follow-up: the §7 "unify" model's Meus Alunos listener needs this to ever return
      // linked-account results, not just self-read/admin).
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isAdmin() || isOwningTrainer(field(resource.data, 'trainerId'))
      );
      // A self-registered student has no users/{uid} doc yet, so claiming an invite is their
      // first-ever write here (create, not update) — allowed only by presenting a currently
      // valid, unused invite minted by the trainerId being claimed.
      allow create: if (isAdmin() && (
          !request.resource.data.keys().hasAny(['platformBillingStatus', 'platformBillingUntil', 'lastAuditId']) ||
          validBillingAuditForUser(uid, null, null, request.resource.data)
        )) || (
        isSignedIn() && request.auth.uid == uid &&
        hasVerifiedEmail() &&
        request.resource.data.role == 'STUDENT' &&
        request.resource.data.trainerId ==
          get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.trainerId &&
        inviteCanBeClaimed(get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data) &&
        // GOALS.md §23d: single-use for real. Checking only that the invite was unused let a client
        // create this doc without marking the invite, and the same code then worked again; the
        // same batch must now leave the invite used (AuthRepository.claimInvite's transaction
        // already does both writes together).
        getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true &&
        grantsNoPermissions(request.resource.data) && isNotSelfPaused(request.resource.data)
      );
      // Three writers:
      // 1. The owning trainer (GOALS.md §17c, and the fix for a pre-existing gap: before this,
      //    no branch let a trainer edit a linked student's profile at all, so EditStudentScreen's
      //    set(merge) on users/{uid} was silently PERMISSION_DENIED). Restricted to the profile
      //    fields TrainerRepository.updateUser writes plus the §17 permission/request flags —
      //    never role/trainerId/inviteCode.
      // 2. The student themselves: own profile fields only. role/trainerId immutable (the
      //    anti-self-promotion guarantee); canSelfAssess/canLogBiometrics immutable (trainer-
      //    granted, §17); pendingAssessmentRequest may only go true -> false, and only in the
      //    same batch that creates the assessment doc named by lastAssessmentId (existsAfter
      //    sees the batch's own writes) — a student can't just dismiss a request.
      // 3. The narrow re-claim exception (GOALS.md §13d): an account that already has a
      //    users/{uid} doc but is still an unclaimed STUDENT (trainerId null) may attach to a
      //    trainer for the first time via the same valid-unused-invite proof the create rule
      //    above requires. Any other existing role/trainerId (TRAINER, ADM, or already linked to
      //    a different trainer) stays blocked — that needs an explicit ADM decision.
      allow update: if (isSignedIn() && request.auth.uid == uid && validSelfProfileUpdate(uid)) || validAdminBillingUpdate() || (
        isOwningTrainer(field(resource.data, 'trainerId')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'gender', 'phone', 'goal', 'experienceLevel', 'medicalNotes', 'trainingDays',
          'canSelfAssess', 'canLogBiometrics', 'canAddSets', 'pendingAssessmentRequest', 'paused'
        ]) && hasValidPauseFlag(request.resource.data)
      ) || (
        field(resource.data, 'role') == 'STUDENT' &&
        field(resource.data, 'trainerId') == null &&
        isSignedIn() && request.auth.uid == uid &&
        hasVerifiedEmail() &&
        request.resource.data.role == 'STUDENT' &&
        request.resource.data.trainerId ==
          get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.trainerId &&
        inviteCanBeClaimed(get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data) &&
        // The invite and this re-claimed profile must be written together.
        getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true &&
        grantsNoPermissions(request.resource.data) &&
        field(request.resource.data, 'paused') == field(resource.data, 'paused')
      );
      // The owning trainer may also remove a linked student's account (symmetric with every
      // other collection here); non-STUDENT docs have no trainerId field so this never matches them.
      allow delete: if isAdmin() || isOwningTrainer(field(resource.data, 'trainerId'));
    }

    // invites/{code} — a single-use claim token minted by a trainer so a student can self-serve
    // role=STUDENT + trainerId without a server (see GOALS.md §7). New website invites do not expire;
    // trainers cancel them manually. Legacy expiry timestamps remain supported.
    match /invites/{code} {
      function hasAdminResolutionAudit(trainerId) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(code);
        let audit = getAfter(auditPath);
        return existsAfter(auditPath) && field(audit.data, 'adminUid') == request.auth.uid &&
          field(audit.data, 'action') == 'invite.resolve' && field(audit.data, 'targetUid') == trainerId &&
          field(audit.data, 'inviteId') == code;
      }

      // v4: a spent invite (used, cancelled, revoked or expired) still holds the student's name,
      // phone and medical notes, so only its trainer, an ADM and the account that claimed it may
      // read it. A live invite stays readable to any signed-in user — the claim reads it before the
      // account exists — and a missing document is readable too (resource == null), so a mistyped
      // code still answers "invalid" instead of "permission denied".
      allow get: if isSignedIn() && (
        resource == null || inviteIsLive(resource.data) ||
        isOwningTrainer(field(resource.data, 'trainerId')) || isAdmin() || isInviteClaimant(code)
      );
      allow list: if isOwningTrainer(field(resource.data, 'trainerId'));
      allow create: if isOwningTrainer(request.resource.data.trainerId) && request.resource.data.used == false &&
        (field(request.resource.data, 'source') != 'web' || (
          request.resource.data.keys().hasAll([
            'trainerId', 'used', 'createdAt', 'expiresAt', 'cancelledAt', 'revokedAt', 'source',
            'draftId', 'name', 'phone', 'gender', 'goal', 'experienceLevel', 'medicalNotes', 'trainingDays'
          ]) &&
          request.resource.data.keys().hasOnly([
            'trainerId', 'used', 'createdAt', 'expiresAt', 'cancelledAt', 'revokedAt', 'source',
            'draftId', 'name', 'phone', 'gender', 'goal', 'experienceLevel', 'medicalNotes', 'trainingDays'
          ]) &&
          request.resource.data.source == 'web' && request.resource.data.createdAt is int &&
          request.resource.data.expiresAt == null && request.resource.data.cancelledAt == null &&
          request.resource.data.revokedAt == null && request.resource.data.draftId is string &&
          request.resource.data.name is string && request.resource.data.phone is string &&
          request.resource.data.gender is string && request.resource.data.goal is string &&
          request.resource.data.experienceLevel is string && request.resource.data.medicalNotes is string &&
          request.resource.data.trainingDays is list &&
          validWebsiteInviteRevision(request.resource.data.trainerId, code, 'create')
        ));
      // The claiming student (not the trainer) performs this write — only the used:false->true
      // transition is permitted, no other field (including trainerId) may change.
      allow update: if (
          isSignedIn() && inviteCanBeClaimed(resource.data) && request.resource.data.used == true &&
          request.resource.data.trainerId == resource.data.trainerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
          // A claim still pairs the invite transition with the student's own profile.
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == code
        ) || (
          isOwningTrainer(resource.data.trainerId) && resource.data.used == false &&
          request.resource.data.used == false && request.resource.data.trainerId == resource.data.trainerId &&
          resource.data.cancelledAt == null && resource.data.revokedAt == null &&
          request.resource.data.cancelledAt is int && request.resource.data.revokedAt == resource.data.revokedAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelledAt']) &&
          validWebsiteInviteRevision(resource.data.trainerId, code, 'cancel')
        ) || (
          isAdmin() && resource.data.used == false && request.resource.data.used == false &&
          request.resource.data.trainerId == resource.data.trainerId &&
          request.resource.data.cancelledAt is int &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelledAt']) &&
          hasAdminResolutionAudit(resource.data.trainerId)
        );
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // The site uses this revision to serialize cooperating invite creation/cancellation attempts.
    // It is deliberately scoped to website invitations; native invite behavior is unchanged.
    match /platformInviteState/{trainerId} {
      function validState(d) {
        return d.keys().hasAll(['trainerId', 'revision', 'lastCode', 'lastAction', 'updatedAt']) &&
          d.keys().hasOnly(['trainerId', 'revision', 'lastCode', 'lastAction', 'updatedAt']) &&
          d.trainerId == trainerId && d.revision is int && d.revision > 0 &&
          d.lastCode is string && d.lastAction in ['create', 'cancel'] && d.updatedAt is int;
      }

      function pairedInvite(action) {
        let invitePath = /databases/$(database)/documents/invites/$(request.resource.data.lastCode);
        let invite = getAfter(invitePath);
        return existsAfter(invitePath) && field(invite.data, 'trainerId') == trainerId &&
          (action == 'create'
            ? field(invite.data, 'source') == 'web' && field(invite.data, 'used') == false
            : field(invite.data, 'cancelledAt') is int && field(invite.data, 'used') == false);
      }

      allow get: if isAdmin() || isOwningTrainer(trainerId);
      allow list: if false;
      allow create: if isOwningTrainer(trainerId) && validState(request.resource.data) &&
        request.resource.data.revision == 1 && pairedInvite(request.resource.data.lastAction);
      allow update: if isOwningTrainer(trainerId) && validState(request.resource.data) &&
        request.resource.data.revision == resource.data.revision + 1 && pairedInvite(request.resource.data.lastAction);
      allow delete: if false;
    }

    // students/{studentId} — owned by trainerId; the linked student can read their own doc.
    match /students/{studentId} {
      function hasRecoveryAudit(trainerId) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(studentId);
        let audit = getAfter(auditPath);
        return existsAfter(auditPath) &&
          field(audit.data, 'adminUid') == request.auth.uid &&
          field(audit.data, 'action') == 'admin.student.create' &&
          field(audit.data, 'targetUid') == trainerId &&
          field(audit.data, 'studentId') == studentId;
      }

      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && request.auth.uid == studentId);
      allow create: if (isOwningTrainer(request.resource.data.trainerId) && hasValidPauseFlag(request.resource.data)) || (
        isAdmin() && request.resource.data.trainerId is string &&
        canReceiveRecoveryDraft(request.resource.data.trainerId) &&
        request.resource.data.keys().hasAll([
          'trainerId', 'name', 'role', 'gender', 'phone', 'goal', 'experienceLevel',
          'medicalNotes', 'trainingDays', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'trainerId', 'name', 'role', 'gender', 'phone', 'goal', 'experienceLevel',
          'medicalNotes', 'trainingDays', 'createdAt'
        ]) &&
        request.resource.data.role == 'student' && request.resource.data.name is string &&
        request.resource.data.gender is string && request.resource.data.phone is string &&
        request.resource.data.goal is string && request.resource.data.experienceLevel is string &&
        request.resource.data.medicalNotes is string && request.resource.data.trainingDays is list &&
        request.resource.data.createdAt is int && hasRecoveryAudit(request.resource.data.trainerId)
      );
      allow update: if isOwningTrainer(resource.data.trainerId) && hasValidPauseFlag(request.resource.data);
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // workouts/{workoutId} — trainer manages; student reads only their own assigned fichas.
    match /workouts/{workoutId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid && resource.data.status == 'assigned');
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.studentId == resource.data.studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // biometrics/{entryId} — trainer manages; student reads their own entries, and may create
    // their own once the trainer set canLogBiometrics on their profile (GOALS.md §17c). The
    // trainerId on the entry must be the student's own trainer, as with workoutLogs.
    match /biometrics/{entryId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if (isOwningTrainer(request.resource.data.trainerId) &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId)) || (
        isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'canLogBiometrics') == true &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId')
      );
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.studentId == resource.data.studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // schedules/{scheduleId} — trainer manages; student reads their own appointments.
    match /schedules/{scheduleId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.studentId == resource.data.studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // workoutLogs/{logId} — the student logs their own performed sets; the owning
    // trainer reads them for the evolution report. trainerId must match the
    // student's own users/{uid}.trainerId so a student can't attribute a log to
    // a trainer they don't belong to.
    match /workoutLogs/{logId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
      // GOALS.md §23d: an update must also start from the caller's own log. Checking only the new
      // studentId let one student overwrite another's log and re-attribute it to themselves.
      allow update: if isSignedIn() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // assessments/{id} — GOALS.md §17: the student's self-assessment history. Created by the
    // student only while their trainer has granted canSelfAssess, attributed to that trainer;
    // read by the owning trainer or the student. Append-only: no update/delete, so history can't
    // be rewritten from a client.
    match /assessments/{id} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'canSelfAssess') == true &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
    }

    // trainerRequests/{uid} — a self-registered STUDENT asks to become a TRAINER; only the ADM
    // can see the queue. Acceptance/rejection are just isAdmin() writes (users/{uid}.role update,
    // or deleting this doc) — this collection carries zero privilege on its own, it's a mailbox.
    match /trainerRequests/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // GOALS.md §27: only from a confirmed address — the ADM's queue is not a place for invented ones.
      allow create: if isSignedIn() && request.auth.uid == uid && hasVerifiedEmail();
      allow delete: if isAdmin();
    }

    // payments/{paymentId} — GOALS.md §23c/§23d: mensalidades, level 1 (recorded by hand; no money
    // moves). Trainer-only: a student never reads these, not even their own — the trainer's
    // decision, 2026-09-22. The id is {studentId}_{YYYY-MM} of the charge's dueDate, which is what
    // makes generating a month's charges idempotent; these rules hold that invariant. The shape is
    // validated because a malformed charge (float cents, a missing paidAt) silently breaks every
    // query that reads it back — see web/src/domain/payments.ts for the model.
    match /payments/{paymentId} {
      function yearMonthOf(date) {
        let parts = date.split('-');
        return parts[0] + '-' + parts[1];
      }

      // Every field always present — `where('paidAt', '==', null)` doesn't match a document that
      // lacks the field. No `id` field: the document id carries it, as in FirestoreMappers.kt.
      function isPayment(d) {
        let fields = ['trainerId', 'studentId', 'amountCents', 'currency', 'dueDate', 'paidAt',
                      'method', 'source', 'externalId', 'note', 'createdAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId is string && d.studentId is string &&
          d.amountCents is int && d.amountCents > 0 &&
          d.currency == 'BRL' &&
          d.dueDate is string &&
          d.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
          (d.paidAt == null || d.paidAt is int) &&
          (d.method == null || d.method in ['pix', 'cash', 'card', 'transfer', 'other']) &&
          d.source in ['manual', 'gateway'] &&
          (d.externalId == null || d.externalId is string) &&
          (d.note == null || (d.note is string && d.note.size() <= 500)) &&
          d.createdAt is int;
      }

      // A charge that doesn't exist yet has no resource.data to check — and that is exactly the
      // read create-if-absent makes (ensureMonthlyCharges reads inside a transaction before
      // creating). For a missing charge, ownership comes from the plan it would be generated from:
      // the id starts with the studentId, and billingPlans/{studentId} names the trainer. No plan,
      // no answer — so nobody can probe other trainers' students.
      allow read: if resource == null
        ? isOwningTrainer(get(/databases/$(database)/documents/billingPlans/$(paymentId.split('_')[0])).data.trainerId)
        : isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isPayment(request.resource.data) &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId) &&
        paymentId == request.resource.data.studentId + '_' + yearMonthOf(request.resource.data.dueDate) &&
        // Clients only ever write manual charges. A level-2 payment gateway would write through
        // the Admin SDK, which bypasses these rules — no client needs to create a gateway charge.
        request.resource.data.source == 'manual' &&
        request.resource.data.externalId == null;
      // Editable: the amount, the due day within the same month (the id encodes the month), and
      // settlement — including undoing a mistaken "paid". A gateway-owned charge is the
      // gateway's to change, never the client's.
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        resource.data.source == 'manual' &&
        isPayment(request.resource.data) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.studentId == resource.data.studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['amountCents', 'dueDate', 'paidAt', 'method', 'note']) &&
        yearMonthOf(request.resource.data.dueDate) == yearMonthOf(resource.data.dueDate);
      allow delete: if isOwningTrainer(resource.data.trainerId) && resource.data.source == 'manual';
    }

    // billingPlans/{studentId} — GOALS.md §23c: the amount and due day a student's monthly charge
    // is generated from. Trainer-only for the same reason as payments — and the reason this isn't
    // fields on users/{uid}: rules are per document, not per field, and a student reads their own
    // users doc.
    match /billingPlans/{studentId} {
      function isBillingPlan(d) {
        let fields = ['studentId', 'trainerId', 'amountCents', 'currency', 'dueDay', 'active', 'createdAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.studentId is string && d.trainerId is string &&
          d.amountCents is int && d.amountCents > 0 &&
          d.currency == 'BRL' &&
          d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31 &&
          d.active is bool &&
          d.createdAt is int;
      }

      allow read, delete: if isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isBillingPlan(request.resource.data) &&
        request.resource.data.studentId == studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId);
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        isBillingPlan(request.resource.data) &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.studentId == studentId &&
        studentIsLinkedToTrainer(request.resource.data.trainerId, request.resource.data.studentId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountCents', 'dueDay', 'active']);
    }

    // §26c summaries are self-reported by the owning trainer. Their exact shapes are allow-listed
    // so an ADM sees bounded, non-student data and cannot manufacture another trainer's metrics.
    match /trainerStats/{trainerId} {
      function isTrainerStats(d) {
        let fields = ['trainerId', 'updatedAt', 'lastSeenAt', 'students', 'sessions7d', 'adherence28d',
                      'quiet', 'pendingAssessments', 'billing'];
        let studentFields = ['total', 'linked', 'pending'];
        let billingFields = ['month', 'activePlans', 'planCents', 'expectedCents', 'receivedCents', 'overdueCents'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId == trainerId && d.trainerId is string && d.updatedAt is int &&
          d.lastSeenAt is int && d.students is map && d.students.keys().hasAll(studentFields) &&
          d.students.keys().hasOnly(studentFields) && d.students.total is int && d.students.total >= 0 &&
          d.students.linked is int && d.students.linked >= 0 && d.students.pending is int && d.students.pending >= 0 &&
          d.sessions7d is int && d.sessions7d >= 0 &&
          (d.adherence28d == null || (d.adherence28d is number && d.adherence28d >= 0 && d.adherence28d <= 1)) &&
          d.quiet is int && d.quiet >= 0 && d.pendingAssessments is int && d.pendingAssessments >= 0 &&
          d.billing is map && d.billing.keys().hasAll(billingFields) && d.billing.keys().hasOnly(billingFields) &&
          d.billing.month is string && d.billing.month.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
          d.billing.activePlans is int && d.billing.activePlans >= 0 &&
          d.billing.planCents is int && d.billing.planCents >= 0 &&
          d.billing.expectedCents is int && d.billing.expectedCents >= 0 &&
          d.billing.receivedCents is int && d.billing.receivedCents >= 0 &&
          d.billing.overdueCents is int && d.billing.overdueCents >= 0;
      }

      allow read: if isAdmin() || isOwningTrainer(trainerId);
      allow create, update: if isOwningTrainer(trainerId) && isTrainerStats(request.resource.data);
      allow delete: if isAdmin();
    }

    match /trainerActivity/{activityId} {
      function allowedActions() {
        return ['login', 'studentCreated', 'inviteGenerated', 'fichaSaved', 'geminiGenerated',
                'chargePaid', 'bookingAdded', 'measurementAdded', 'assessmentRequested'];
      }

      function isTrainerActivity(d) {
        let fields = ['trainerId', 'month', 'updatedAt', 'actions', 'activeDays'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId is string && d.month is string && d.month.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
          activityId == d.trainerId + '_' + d.month && d.updatedAt is int &&
          d.actions is map && d.actions.keys().hasOnly(allowedActions());
      }

      function actionsAreNonnegative(actions) {
        return (!('login' in actions) || (actions.login is int && actions.login >= 0)) &&
          (!('studentCreated' in actions) || (actions.studentCreated is int && actions.studentCreated >= 0)) &&
          (!('inviteGenerated' in actions) || (actions.inviteGenerated is int && actions.inviteGenerated >= 0)) &&
          (!('fichaSaved' in actions) || (actions.fichaSaved is int && actions.fichaSaved >= 0)) &&
          (!('geminiGenerated' in actions) || (actions.geminiGenerated is int && actions.geminiGenerated >= 0)) &&
          (!('chargePaid' in actions) || (actions.chargePaid is int && actions.chargePaid >= 0)) &&
          (!('bookingAdded' in actions) || (actions.bookingAdded is int && actions.bookingAdded >= 0)) &&
          (!('measurementAdded' in actions) || (actions.measurementAdded is int && actions.measurementAdded >= 0)) &&
          (!('assessmentRequested' in actions) || (actions.assessmentRequested is int && actions.assessmentRequested >= 0));
      }

      function actionsDoNotDecrease(next, previous) {
        return (('login' in next) ? next.login >= previous.get('login', 0) : previous.get('login', 0) == 0) &&
          (('studentCreated' in next) ? next.studentCreated >= previous.get('studentCreated', 0) : previous.get('studentCreated', 0) == 0) &&
          (('inviteGenerated' in next) ? next.inviteGenerated >= previous.get('inviteGenerated', 0) : previous.get('inviteGenerated', 0) == 0) &&
          (('fichaSaved' in next) ? next.fichaSaved >= previous.get('fichaSaved', 0) : previous.get('fichaSaved', 0) == 0) &&
          (('geminiGenerated' in next) ? next.geminiGenerated >= previous.get('geminiGenerated', 0) : previous.get('geminiGenerated', 0) == 0) &&
          (('chargePaid' in next) ? next.chargePaid >= previous.get('chargePaid', 0) : previous.get('chargePaid', 0) == 0) &&
          (('bookingAdded' in next) ? next.bookingAdded >= previous.get('bookingAdded', 0) : previous.get('bookingAdded', 0) == 0) &&
          (('measurementAdded' in next) ? next.measurementAdded >= previous.get('measurementAdded', 0) : previous.get('measurementAdded', 0) == 0) &&
          (('assessmentRequested' in next) ? next.assessmentRequested >= previous.get('assessmentRequested', 0) : previous.get('assessmentRequested', 0) == 0);
      }

      function validDays(days) {
        return days is list && days.size() <= 31 &&
          (days.size() < 1 || days[0] is string) && (days.size() < 2 || days[1] is string) &&
          (days.size() < 3 || days[2] is string) && (days.size() < 4 || days[3] is string) &&
          (days.size() < 5 || days[4] is string) && (days.size() < 6 || days[5] is string) &&
          (days.size() < 7 || days[6] is string) && (days.size() < 8 || days[7] is string) &&
          (days.size() < 9 || days[8] is string) && (days.size() < 10 || days[9] is string) &&
          (days.size() < 11 || days[10] is string) && (days.size() < 12 || days[11] is string) &&
          (days.size() < 13 || days[12] is string) && (days.size() < 14 || days[13] is string) &&
          (days.size() < 15 || days[14] is string) && (days.size() < 16 || days[15] is string) &&
          (days.size() < 17 || days[16] is string) && (days.size() < 18 || days[17] is string) &&
          (days.size() < 19 || days[18] is string) && (days.size() < 20 || days[19] is string) &&
          (days.size() < 21 || days[20] is string) && (days.size() < 22 || days[21] is string) &&
          (days.size() < 23 || days[22] is string) && (days.size() < 24 || days[23] is string) &&
          (days.size() < 25 || days[24] is string) && (days.size() < 26 || days[25] is string) &&
          (days.size() < 27 || days[26] is string) && (days.size() < 28 || days[27] is string) &&
          (days.size() < 29 || days[28] is string) && (days.size() < 30 || days[29] is string) &&
          (days.size() < 31 || days[30] is string);
      }

      allow read: if isAdmin() || isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isTrainerActivity(request.resource.data) && actionsAreNonnegative(request.resource.data.actions) && validDays(request.resource.data.activeDays);
      allow update: if isOwningTrainer(request.resource.data.trainerId) &&
        isTrainerActivity(request.resource.data) && resource.data.trainerId == request.resource.data.trainerId &&
        actionsAreNonnegative(request.resource.data.actions) && actionsDoNotDecrease(request.resource.data.actions, resource.data.actions) &&
        validDays(request.resource.data.activeDays);
      allow delete: if isAdmin();
    }

    match /platformPlanTemplates/{templateId} {
      function linkedTemplateAudit(d, action) {
        let auditId = field(d, 'lastAuditId');
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let auditAfter = getAfter(auditPath);
        return auditId is string && !exists(auditPath) && existsAfter(auditPath) &&
          field(auditAfter.data, 'adminUid') == request.auth.uid &&
          field(auditAfter.data, 'action') == action &&
          field(auditAfter.data, 'targetUid') == templateId &&
          field(auditAfter.data, 'templateId') == templateId &&
          field(auditAfter.data, 'templateVersion') == d.version;
      }

      function validTemplate(d) {
        let fields = ['name', 'monthlyBaseCents', 'includedStudentSeats', 'extraStudentMonthlyCents',
                      'maxActiveInviteCodes', 'trialDurationDays', 'version'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields.concat(['lastAuditId'])) &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
          d.monthlyBaseCents is int && d.monthlyBaseCents >= 0 &&
          d.includedStudentSeats is int && d.includedStudentSeats >= 0 &&
          d.extraStudentMonthlyCents is int && d.extraStudentMonthlyCents >= 0 &&
          d.maxActiveInviteCodes is int && d.maxActiveInviteCodes >= 0 &&
          d.trialDurationDays is int && d.trialDurationDays >= 0 &&
          d.version is int && d.version > 0;
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && validTemplate(request.resource.data) && request.resource.data.version == 1 &&
        request.resource.data.lastAuditId is string && linkedTemplateAudit(request.resource.data, 'platform.plan.create');
      allow update: if isAdmin() && validTemplate(request.resource.data) &&
        request.resource.data.version == resource.data.version + 1 && request.resource.data.lastAuditId is string &&
        linkedTemplateAudit(request.resource.data, 'platform.plan.update');
      allow delete: if false;
    }

    // GOALS.md §35: the "default trial" document is retired. The ADM now assigns every plan by hand, so
    // nothing reads or writes it any more; an existing document is left in place, untouched and unreachable.
    match /platformBillingConfig/{configId} {
      allow read, write: if false;
    }

    match /platformSubscriptions/{trainerUid} {
      function linkedSubscriptionAudit(d) {
        let auditId = field(d, 'lastAuditId');
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let userPath = /databases/$(database)/documents/users/$(trainerUid);
        let auditAfter = getAfter(auditPath);
        let userBefore = get(userPath);
        let userAfter = getAfter(userPath);
        return auditId is string && !exists(auditPath) && existsAfter(auditPath) && exists(userPath) && existsAfter(userPath) &&
          field(auditAfter.data, 'adminUid') == request.auth.uid &&
          field(auditAfter.data, 'targetUid') == trainerUid &&
          field(userAfter.data, 'lastAuditId') == auditId &&
          validBillingAuditForUser(
            trainerUid,
            field(userBefore.data, 'platformBillingStatus'),
            field(userBefore.data, 'platformBillingUntil'),
            userAfter.data
          ) &&
          ((field(auditAfter.data, 'action') == 'subscription.assign' &&
              field(auditAfter.data, 'subscriptionVersion') == field(field(d, 'terms'), 'snapshotVersion') &&
              field(auditAfter.data, 'templateId') == field(field(d, 'terms'), 'templateId') &&
              field(auditAfter.data, 'templateVersion') == field(field(d, 'terms'), 'templateVersion') &&
              field(auditAfter.data, 'mode') == d.mode &&
              field(auditAfter.data, 'effectiveAt') == d.effectiveAt) ||
            (field(auditAfter.data, 'action') == 'trial.extend' &&
              d.mode == 'trial' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialEndsAt', 'updatedAt', 'lastAuditId']) &&
              field(auditAfter.data, 'fromTrialEndsAt') == field(get(/databases/$(database)/documents/platformSubscriptions/$(trainerUid)).data, 'trialEndsAt') &&
              field(auditAfter.data, 'toTrialEndsAt') == d.trialEndsAt &&
              field(auditAfter.data, 'days') is int && field(auditAfter.data, 'days') > 0) ||
            // §35: the first payment turns a trial into a paid subscription; voiding that payment turns it back.
            (field(auditAfter.data, 'action') in ['payment.record', 'payment.void'] &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mode', 'updatedAt', 'lastAuditId']) &&
              field(auditAfter.data, 'paymentId') is string &&
              existsAfter(/databases/$(database)/documents/platformPayments/$(field(auditAfter.data, 'paymentId'))) &&
              ((field(auditAfter.data, 'action') == 'payment.record' && field(resource.data, 'mode') == 'trial' && d.mode == 'paid') ||
                (field(auditAfter.data, 'action') == 'payment.void' && field(resource.data, 'mode') == 'paid' && d.mode == 'trial'))));
      }

      function validSubscription(d) {
        return d.keys().hasAll([
            'trainerUid', 'mode', 'terms', 'overrides', 'chargeDuringTrial', 'effectiveAt',
            'trialStartedAt', 'trialEndsAt', 'currentInvoiceId', 'updatedAt'
          ]) &&
          d.keys().hasOnly([
            'trainerUid', 'mode', 'terms', 'overrides', 'chargeDuringTrial', 'effectiveAt',
            'trialStartedAt', 'trialEndsAt', 'currentInvoiceId', 'updatedAt', 'lastAuditId'
          ]) &&
          d.trainerUid == trainerUid && d.mode in ['trial', 'paid'] &&
          d.terms is map && d.overrides is map && d.chargeDuringTrial is bool &&
          d.effectiveAt is int && (d.trialStartedAt == null || d.trialStartedAt is int) &&
          (d.trialEndsAt == null || d.trialEndsAt is int) &&
          (d.currentInvoiceId == null || d.currentInvoiceId is string) && d.updatedAt is int;
      }

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == trainerUid && myRole() == 'TRAINER');
      allow create, update: if isAdmin() && validSubscription(request.resource.data) &&
        request.resource.data.lastAuditId is string && linkedSubscriptionAudit(request.resource.data);
      allow delete: if false;
    }

    match /platformInvoices/{invoiceId} {
      function linkedInvoiceAudit(d, action) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let auditId = field(d, 'lastAuditId');
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let userPath = /databases/$(database)/documents/users/$(d.trainerUid);
        let auditAfter = getAfter(auditPath);
        let userBefore = get(userPath);
        let userAfter = getAfter(userPath);
        return auditId is string && !exists(auditPath) && existsAfter(auditPath) && exists(userPath) && existsAfter(userPath) &&
          field(auditAfter.data, 'adminUid') == request.auth.uid &&
          field(auditAfter.data, 'targetUid') == d.trainerUid &&
          field(auditAfter.data, 'action') == action &&
          field(auditAfter.data, 'invoiceId') == invoiceId &&
          field(userAfter.data, 'lastAuditId') == auditId &&
          validBillingAuditForUser(
            d.trainerUid,
            field(userBefore.data, 'platformBillingStatus'),
            field(userBefore.data, 'platformBillingUntil'),
            userAfter.data
          ) &&
          (action == 'invoice.payment'
            ? changed.hasOnly(['status', 'paidAt', 'paidBy', 'paymentReference', 'reservedInviteSeats', 'billableStudentSeats', 'lastAuditId']) &&
              field(resource.data, 'status') == 'unpaid' && d.status == 'paid' &&
              field(auditAfter.data, 'amountCents') == d.amountCents &&
              field(auditAfter.data, 'paymentReference') == d.paymentReference && d.paidBy == request.auth.uid
            : changed.hasOnly(['dueDate', 'reservedInviteSeats', 'billableStudentSeats', 'lastAuditId']) &&
              field(resource.data, 'status') == 'unpaid' && d.status == 'unpaid' &&
              d.dueDate > field(auditAfter.data, 'fromDueDate') &&
              field(auditAfter.data, 'toDueDate') == d.dueDate &&
              field(auditAfter.data, 'fromDueDate') == field(resource.data, 'dueDate') &&
              field(auditAfter.data, 'days') is int && field(auditAfter.data, 'days') > 0);
      }

      function validInvoice(d) {
        let fields = ['id', 'trainerUid', 'period', 'dueDate', 'linkedStudentSeats', 'includedStudentSeats',
                      'extraStudentSeats', 'monthlyBaseCents', 'extraStudentMonthlyCents', 'extraAmountCents',
                      'amountCents', 'status', 'paidAt', 'paidBy', 'paymentReference', 'createdAt',
                      'createdBy', 'subscriptionVersion', 'templateId', 'templateVersion'];
        let seatFields = ['reservedInviteSeats', 'billableStudentSeats'];
        let hasSeatSnapshot = d.keys().hasAll(seatFields);
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields.concat(seatFields).concat(['lastAuditId'])) &&
          d.id == invoiceId && d.trainerUid is string &&
          d.period is string && d.period.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
          d.dueDate is string && d.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
          d.linkedStudentSeats is int && d.linkedStudentSeats >= 0 &&
          d.includedStudentSeats is int && d.includedStudentSeats >= 0 &&
          d.extraStudentSeats is int && d.extraStudentSeats >= 0 &&
          d.monthlyBaseCents is int && d.monthlyBaseCents >= 0 &&
          d.extraStudentMonthlyCents is int && d.extraStudentMonthlyCents >= 0 &&
          d.extraAmountCents is int && d.extraAmountCents >= 0 &&
          (hasSeatSnapshot
            ? d.reservedInviteSeats is int && d.reservedInviteSeats >= 0 &&
              d.billableStudentSeats is int && d.billableStudentSeats == d.linkedStudentSeats + d.reservedInviteSeats
            : !d.keys().hasAny(seatFields)) &&
          d.amountCents is int && d.amountCents >= 0 && d.status in ['unpaid', 'paid'] &&
          (d.paidAt == null || d.paidAt is int) && (d.paidBy == null || d.paidBy is string) &&
          (d.paymentReference == null || (d.paymentReference is string && d.paymentReference.size() <= 120)) &&
          d.createdAt is int && d.createdBy is string && d.subscriptionVersion is int &&
          d.templateId is string && d.templateVersion is int &&
          (d.status == 'unpaid' ? d.paidAt == null && d.paidBy == null : d.paidAt is int && d.paidBy is string);
      }

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.trainerUid && myRole() == 'TRAINER');
      // Invoice creation is only through the Admin SDK callable so clients cannot bypass its
      // serializable, privacy-safe student and invite reservation count.
      allow create: if false;
      allow update: if isAdmin() && validInvoice(request.resource.data) &&
        request.resource.data.lastAuditId is string &&
        request.resource.data.keys().hasAll(['reservedInviteSeats', 'billableStudentSeats']) &&
        request.resource.data.trainerUid == resource.data.trainerUid &&
        request.resource.data.period == resource.data.period &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dueDate', 'status', 'paidAt', 'paidBy', 'paymentReference', 'reservedInviteSeats', 'billableStudentSeats', 'lastAuditId'
        ]) &&
        (resource.data.keys().hasAll(['reservedInviteSeats', 'billableStudentSeats'])
          ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reservedInviteSeats', 'billableStudentSeats'])
          : request.resource.data.reservedInviteSeats == 0 &&
            request.resource.data.billableStudentSeats == request.resource.data.linkedStudentSeats) &&
        (request.resource.data.dueDate != resource.data.dueDate
          ? linkedInvoiceAudit(request.resource.data, 'invoice.extend')
          : linkedInvoiceAudit(request.resource.data, 'invoice.payment'));
      allow delete: if false;
    }

    // GOALS.md §35: the append-only ledger of what the ADM recorded as received from a trainer. The ADM's
    // browser writes it (no Cloud Function, so it works on the Spark plan); every entry is tied to its audit
    // entry and to the trainer's new access state in the same commit. A trainer reads only their own entries.
    // A void is the one allowed change, and only while the trainer's expiry is still the one this payment set.
    match /platformPayments/{paymentId} {
      function validPayment(d) {
        let fields = ['id', 'trainerUid', 'paidAt', 'paidBy', 'amountCents', 'paymentReference', 'newUntil',
                      'paidThroughDate', 'previousUntil', 'previousStatus', 'previousMode', 'planName', 'templateId',
                      'templateVersion', 'snapshotVersion', 'voidedAt', 'voidedBy', 'lastAuditId'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.id == paymentId && d.trainerUid is string && d.paidAt is int && d.paidBy is string &&
          d.amountCents is int && d.amountCents >= 0 &&
          (d.paymentReference == null || (d.paymentReference is string && d.paymentReference.size() <= 120)) &&
          d.newUntil is int &&
          d.paidThroughDate is string && d.paidThroughDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
          (d.previousUntil == null || d.previousUntil is int) &&
          d.previousStatus in ['pending', 'trial', 'current', 'blocked'] &&
          d.previousMode in ['trial', 'paid'] &&
          d.planName is string && d.planName.size() > 0 && d.planName.size() <= 80 &&
          d.templateId is string && d.templateVersion is int && d.templateVersion > 0 &&
          d.snapshotVersion is int && d.snapshotVersion > 0 &&
          (d.voidedAt == null || d.voidedAt is int) && (d.voidedBy == null || d.voidedBy is string) &&
          d.lastAuditId is string;
      }

      function linkedPaymentAudit(d, action) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(d.lastAuditId);
        let userPath = /databases/$(database)/documents/users/$(d.trainerUid);
        let auditAfter = getAfter(auditPath);
        let userBefore = get(userPath);
        let userAfter = getAfter(userPath);
        return !exists(auditPath) && existsAfter(auditPath) && exists(userPath) && existsAfter(userPath) &&
          field(userBefore.data, 'role') == 'TRAINER' &&
          field(auditAfter.data, 'adminUid') == request.auth.uid &&
          field(auditAfter.data, 'targetUid') == d.trainerUid &&
          field(auditAfter.data, 'action') == action &&
          field(auditAfter.data, 'paymentId') == paymentId &&
          field(userAfter.data, 'lastAuditId') == d.lastAuditId &&
          validBillingAuditForUser(
            d.trainerUid,
            field(userBefore.data, 'platformBillingStatus'),
            field(userBefore.data, 'platformBillingUntil'),
            userAfter.data
          );
      }

      allow read: if isAdmin() ||
        (isSignedIn() && myRole() == 'TRAINER' && request.auth.uid == resource.data.trainerUid);

      allow create: if isAdmin() && validPayment(request.resource.data) &&
        request.resource.data.paidBy == request.auth.uid &&
        request.resource.data.voidedAt == null && request.resource.data.voidedBy == null &&
        request.resource.data.newUntil > request.time.toMillis() &&
        linkedPaymentAudit(request.resource.data, 'payment.record') &&
        exists(/databases/$(database)/documents/platformSubscriptions/$(request.resource.data.trainerUid)) &&
        field(get(/databases/$(database)/documents/users/$(request.resource.data.trainerUid)).data, 'platformBillingStatus') == request.resource.data.previousStatus &&
        field(get(/databases/$(database)/documents/users/$(request.resource.data.trainerUid)).data, 'platformBillingUntil') == request.resource.data.previousUntil &&
        field(get(/databases/$(database)/documents/platformSubscriptions/$(request.resource.data.trainerUid)).data, 'mode') == request.resource.data.previousMode &&
        field(getAfter(/databases/$(database)/documents/users/$(request.resource.data.trainerUid)).data, 'platformBillingStatus') == 'current' &&
        field(getAfter(/databases/$(database)/documents/users/$(request.resource.data.trainerUid)).data, 'platformBillingUntil') == request.resource.data.newUntil &&
        field(getAfter(/databases/$(database)/documents/platformSubscriptions/$(request.resource.data.trainerUid)).data, 'mode') == 'paid';

      allow update: if isAdmin() && validPayment(request.resource.data) &&
        resource.data.voidedAt == null && request.resource.data.voidedAt is int &&
        request.resource.data.voidedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voidedAt', 'voidedBy', 'lastAuditId']) &&
        linkedPaymentAudit(request.resource.data, 'payment.void') &&
        field(get(/databases/$(database)/documents/users/$(resource.data.trainerUid)).data, 'platformBillingStatus') == 'current' &&
        field(get(/databases/$(database)/documents/users/$(resource.data.trainerUid)).data, 'platformBillingUntil') == resource.data.newUntil &&
        field(getAfter(/databases/$(database)/documents/users/$(resource.data.trainerUid)).data, 'platformBillingStatus') == resource.data.previousStatus &&
        field(getAfter(/databases/$(database)/documents/users/$(resource.data.trainerUid)).data, 'platformBillingUntil') == resource.data.previousUntil &&
        field(getAfter(/databases/$(database)/documents/platformSubscriptions/$(resource.data.trainerUid)).data, 'mode') == resource.data.previousMode;

      allow delete: if false;
    }

    match /adminAudit/{auditId} {
      function validPaymentAuditAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let paymentAfter = getAfter(/databases/$(database)/documents/platformPayments/$(d.paymentId));
        return !exists(auditPath) && existsAfter(/databases/$(database)/documents/platformPayments/$(d.paymentId)) &&
          validBillingUserAfter(d) &&
          field(paymentAfter.data, 'lastAuditId') == auditId &&
          field(paymentAfter.data, 'trainerUid') == d.targetUid &&
          field(paymentAfter.data, 'amountCents') == d.amountCents &&
          (d.action == 'payment.record'
            ? field(paymentAfter.data, 'paidThroughDate') == d.paidThroughDate && field(paymentAfter.data, 'voidedAt') == null
            : field(paymentAfter.data, 'voidedAt') is int);
      }

      function validBillingUserAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let userPath = /databases/$(database)/documents/users/$(d.targetUid);
        let userAfter = getAfter(userPath);
        return !exists(auditPath) && existsAfter(userPath) &&
          field(userAfter.data, 'lastAuditId') == auditId &&
          field(userAfter.data, 'platformBillingStatus') == field(d, 'billingToStatus') &&
          field(userAfter.data, 'platformBillingUntil') == field(d, 'billingToUntil');
      }

      function validTrainerBillingAuditAfter(d) {
        let userPath = /databases/$(database)/documents/users/$(d.targetUid);
        let userAfter = getAfter(userPath);
        return validBillingUserAfter(d) && field(userAfter.data, 'role') == 'TRAINER';
      }

      function invoiceIsPaid(invoiceId) {
        let invoicePath = /databases/$(database)/documents/platformInvoices/$(invoiceId);
        return exists(invoicePath) && field(get(invoicePath).data, 'status') == 'paid';
      }

      function assignmentHasNoUnpaidInvoice(subscriptionPath, subscriptionBefore) {
        return !exists(subscriptionPath) ||
          field(subscriptionBefore.data, 'currentInvoiceId') == null ||
          invoiceIsPaid(field(subscriptionBefore.data, 'currentInvoiceId'));
      }

      function keepsExpiredBillingBlocked(userBefore, d) {
        let status = field(userBefore, 'platformBillingStatus');
        let until = field(userBefore, 'platformBillingUntil');
        let expired = until != null && (!(until is int) || until <= request.time.toMillis());
        return (!(status == 'blocked' || expired) || field(d, 'billingToStatus') == 'blocked');
      }

      function validSubscriptionAuditAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let subscriptionPath = /databases/$(database)/documents/platformSubscriptions/$(d.targetUid);
        let subscriptionAfter = getAfter(subscriptionPath);
        let subscriptionBefore = get(subscriptionPath);
        let userBefore = get(/databases/$(database)/documents/users/$(d.targetUid));
        return !exists(auditPath) && existsAfter(subscriptionPath) && validBillingUserAfter(d) &&
          field(subscriptionAfter.data, 'trainerUid') == d.targetUid &&
          field(subscriptionAfter.data, 'lastAuditId') == auditId &&
          ((d.action == 'subscription.assign' &&
              assignmentHasNoUnpaidInvoice(subscriptionPath, subscriptionBefore) &&
              field(field(subscriptionAfter.data, 'terms'), 'snapshotVersion') == d.subscriptionVersion &&
              field(field(subscriptionAfter.data, 'terms'), 'templateId') == d.templateId &&
              field(field(subscriptionAfter.data, 'terms'), 'templateVersion') == d.templateVersion &&
              field(subscriptionAfter.data, 'mode') == d.mode &&
              field(subscriptionAfter.data, 'effectiveAt') == d.effectiveAt) ||
            (d.action == 'trial.extend' && exists(subscriptionPath) &&
              keepsExpiredBillingBlocked(userBefore.data, d) &&
              field(subscriptionBefore.data, 'trialEndsAt') == d.fromTrialEndsAt &&
              field(subscriptionAfter.data, 'mode') == 'trial' &&
              field(subscriptionAfter.data, 'trialEndsAt') == d.toTrialEndsAt &&
              d.toTrialEndsAt > d.fromTrialEndsAt && d.days > 0));
      }

      function validInvoiceChangeAuditAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let invoicePath = /databases/$(database)/documents/platformInvoices/$(d.invoiceId);
        let invoiceAfter = getAfter(invoicePath);
        let invoiceBefore = get(invoicePath);
        let userBefore = get(/databases/$(database)/documents/users/$(d.targetUid));
        return !exists(auditPath) && existsAfter(invoicePath) && validBillingUserAfter(d) &&
          field(invoiceAfter.data, 'lastAuditId') == auditId &&
          field(invoiceAfter.data, 'trainerUid') == d.targetUid &&
          ((d.action == 'invoice.payment' && exists(invoicePath) &&
              field(invoiceBefore.data, 'status') == 'unpaid' &&
              field(invoiceAfter.data, 'status') == 'paid' &&
              field(invoiceAfter.data, 'paidBy') == d.adminUid &&
              field(invoiceAfter.data, 'amountCents') == d.amountCents &&
              field(invoiceAfter.data, 'paymentReference') == d.paymentReference) ||
            (d.action == 'invoice.extend' && exists(invoicePath) &&
              keepsExpiredBillingBlocked(userBefore.data, d) &&
              field(invoiceBefore.data, 'status') == 'unpaid' &&
              field(invoiceAfter.data, 'status') == 'unpaid' &&
              field(invoiceBefore.data, 'dueDate') == d.fromDueDate &&
              field(invoiceAfter.data, 'dueDate') == d.toDueDate &&
              d.toDueDate > d.fromDueDate && d.days > 0));
      }

      function validInvoiceIssueAuditAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let invoicePath = /databases/$(database)/documents/platformInvoices/$(d.invoiceId);
        let invoiceAfter = getAfter(invoicePath);
        let subscriptionPath = /databases/$(database)/documents/platformSubscriptions/$(d.targetUid);
        let subscriptionAfter = getAfter(subscriptionPath);
        return !exists(auditPath) && existsAfter(invoicePath) && existsAfter(subscriptionPath) && validBillingUserAfter(d) &&
          field(invoiceAfter.data, 'lastAuditId') == auditId &&
          field(invoiceAfter.data, 'trainerUid') == d.targetUid &&
          field(invoiceAfter.data, 'id') == d.invoiceId &&
          field(invoiceAfter.data, 'period') == d.period &&
          field(invoiceAfter.data, 'linkedStudentSeats') == d.linkedStudentSeats &&
          field(invoiceAfter.data, 'amountCents') == d.amountCents &&
          field(subscriptionAfter.data, 'lastAuditId') == auditId &&
          field(subscriptionAfter.data, 'currentInvoiceId') == d.invoiceId;
      }

      function validPlanTemplateAuditAfter(d) {
        let auditPath = /databases/$(database)/documents/adminAudit/$(auditId);
        let templatePath = /databases/$(database)/documents/platformPlanTemplates/$(d.templateId);
        let templateAfter = getAfter(templatePath);
        return !exists(auditPath) && existsAfter(templatePath) &&
          field(templateAfter.data, 'lastAuditId') == auditId &&
          field(templateAfter.data, 'version') == d.templateVersion &&
          d.targetUid == d.templateId;
      }


      function validAudit(d) {
        let base = ['at', 'adminUid', 'action', 'targetUid', 'note'];
        let billing = ['billingFromStatus', 'billingFromUntil', 'billingToStatus', 'billingToUntil'];
        return d.keys().hasAll(base) && d.at is int && d.adminUid == request.auth.uid &&
          d.targetUid is string && d.note is string && d.note.size() <= 200 && (
            (d.action in ['trainer.suspend', 'trainer.reactivate', 'request.reject', 'trainer.resetEmail'] && d.keys().hasOnly(base)) ||
            (d.action in ['trainer.create', 'trainer.promote'] &&
              d.keys().hasAll(base.concat(billing)) && d.keys().hasOnly(base.concat(billing)) &&
              validTrainerBillingAuditAfter(d)) ||
            (d.action == 'invite.resolve' &&
              d.keys().hasAll(base.concat(['inviteId'])) && d.keys().hasOnly(base.concat(['inviteId'])) &&
              d.inviteId is string &&
              getAfter(/databases/$(database)/documents/invites/$(d.inviteId)).data.trainerId == d.targetUid &&
              getAfter(/databases/$(database)/documents/invites/$(d.inviteId)).data.cancelledAt is int) ||
            (d.action in ['platform.plan.create', 'platform.plan.update'] &&
              d.keys().hasAll(base.concat(['templateId', 'templateVersion'])) &&
              d.keys().hasOnly(base.concat(['templateId', 'templateVersion'])) &&
              d.templateId is string && d.targetUid == d.templateId && d.templateVersion is int && d.templateVersion > 0 &&
              validPlanTemplateAuditAfter(d)) ||
            (d.action == 'payment.record' &&
              d.keys().hasAll(base.concat(['paymentId', 'amountCents', 'paymentReference', 'paidThroughDate']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['paymentId', 'amountCents', 'paymentReference', 'paidThroughDate']).concat(billing)) &&
              d.paymentId is string && d.amountCents is int && d.amountCents >= 0 &&
              (d.paymentReference == null || (d.paymentReference is string && d.paymentReference.size() <= 120)) &&
              d.paidThroughDate is string &&
              validPaymentAuditAfter(d)) ||
            (d.action == 'payment.void' &&
              d.keys().hasAll(base.concat(['paymentId', 'amountCents']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['paymentId', 'amountCents']).concat(billing)) &&
              d.paymentId is string && d.amountCents is int && d.amountCents >= 0 &&
              validPaymentAuditAfter(d)) ||
            (d.action == 'subscription.assign' &&
              d.keys().hasAll(base.concat(['subscriptionVersion', 'templateId', 'templateVersion', 'mode', 'overrideKeys', 'effectiveAt']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['subscriptionVersion', 'templateId', 'templateVersion', 'mode', 'overrideKeys', 'effectiveAt']).concat(billing)) &&
              d.subscriptionVersion is int && d.subscriptionVersion > 0 && d.templateId is string &&
              d.templateVersion is int && d.mode in ['trial', 'paid'] && d.overrideKeys is list && d.effectiveAt is int &&
              validSubscriptionAuditAfter(d)) ||
            (d.action == 'invoice.issue' &&
              d.keys().hasAll(base.concat(['invoiceId', 'period', 'linkedStudentSeats', 'amountCents']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['invoiceId', 'period', 'linkedStudentSeats', 'amountCents']).concat(billing)) &&
              d.invoiceId is string && d.period is string && d.linkedStudentSeats is int &&
              d.linkedStudentSeats >= 0 && d.amountCents is int && d.amountCents >= 0 &&
              validInvoiceIssueAuditAfter(d)) ||
            (d.action == 'invoice.payment' &&
              d.keys().hasAll(base.concat(['invoiceId', 'amountCents', 'paymentReference']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['invoiceId', 'amountCents', 'paymentReference']).concat(billing)) &&
              d.invoiceId is string && d.amountCents is int && d.amountCents >= 0 &&
              (d.paymentReference == null || (d.paymentReference is string && d.paymentReference.size() <= 120)) &&
              validInvoiceChangeAuditAfter(d)) ||
            (d.action == 'invoice.extend' &&
              d.keys().hasAll(base.concat(['invoiceId', 'days', 'fromDueDate', 'toDueDate']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['invoiceId', 'days', 'fromDueDate', 'toDueDate']).concat(billing)) &&
              d.invoiceId is string && d.days is int && d.days > 0 &&
              d.fromDueDate is string && d.toDueDate is string &&
              validInvoiceChangeAuditAfter(d)) ||
            (d.action == 'trial.extend' &&
              d.keys().hasAll(base.concat(['days', 'fromTrialEndsAt', 'toTrialEndsAt']).concat(billing)) &&
              d.keys().hasOnly(base.concat(['days', 'fromTrialEndsAt', 'toTrialEndsAt']).concat(billing)) &&
              d.days is int && d.days > 0 && d.fromTrialEndsAt is int && d.toTrialEndsAt is int &&
              validSubscriptionAuditAfter(d)) ||
            (d.action == 'admin.student.create' &&
              d.keys().hasAll(base.concat(['studentId'])) && d.keys().hasOnly(base.concat(['studentId'])) &&
              d.studentId is string)
          );
      }

      allow read: if isAdmin();
      function validInviteAudit(d) {
        let fields = ['at', 'actorUid', 'actorRole', 'action', 'targetUid', 'note', 'inviteId'];
        let invitePath = /databases/$(database)/documents/invites/$(d.inviteId);
        let inviteAfter = getAfter(invitePath);
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) && d.at is int &&
          d.actorUid == request.auth.uid && d.actorRole in ['TRAINER', 'STUDENT'] &&
          d.action in ['invite.create', 'invite.claim', 'invite.cancel'] && d.targetUid is string &&
          d.note is string && d.note.size() <= 200 && d.inviteId is string && existsAfter(invitePath) &&
          ((d.actorRole == 'TRAINER' && d.action in ['invite.create', 'invite.cancel'] &&
            d.targetUid == d.actorUid && isOwningTrainer(d.targetUid) &&
            field(inviteAfter.data, 'trainerId') == d.targetUid &&
            (d.action == 'invite.create'
              ? field(inviteAfter.data, 'source') == 'web' && field(inviteAfter.data, 'used') == false
              : field(inviteAfter.data, 'cancelledAt') is int && field(inviteAfter.data, 'used') == false)) ||
          (d.actorRole == 'STUDENT' && d.action == 'invite.claim' && hasVerifiedEmail() &&
            field(inviteAfter.data, 'used') == true &&
            field(getAfter(/databases/$(database)/documents/users/$(d.actorUid)).data, 'trainerId') == d.targetUid &&
            field(getAfter(/databases/$(database)/documents/users/$(d.actorUid)).data, 'inviteCode') == d.inviteId));
      }

      allow create: if (isAdmin() && validAudit(request.resource.data)) || validInviteAudit(request.resource.data);
    }

    // appData/exerciseCatalog — GOALS.md §33. The trainer's exercise reference: the web's ficha editor reads it to
    // fill each exercise's muscles, and it must never be a public file or part of the page. So: `get` only, and only
    // for the ADM or a trainer who passes the same test as every other protected read (role TRAINER, not suspended,
    // platform billing current — isOwningTrainer on their own uid). Students, anonymous callers, suspended and
    // billing-locked trainers are denied. There is no `list`: nobody can enumerate the collection. Writes belong
    // to the ADM alone (the owner's publish script, signed in as ADM) and the shape is checked; no delete.
    match /appData/{docId} {
      function validCatalog(d) {
        return d.keys().hasOnly(['version', 'exercises', 'updatedAt']) &&
          d.version is string && d.version.size() > 0 && d.version.size() <= 64 &&
          d.exercises is list && d.exercises.size() >= 1 && d.exercises.size() <= 300 &&
          d.updatedAt is int;
      }

      allow get: if docId == 'exerciseCatalog' && isSignedIn() &&
        (isAdmin() || isOwningTrainer(request.auth.uid));
      allow create, update: if docId == 'exerciseCatalog' && isAdmin() && validCatalog(request.resource.data);
    }

    // Everything else: denied by default (no catch-all match).
  }
}
