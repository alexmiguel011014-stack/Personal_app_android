<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Gemini/OpenAI/DeepSeek/Claude API keys live here (SettingsRepository) — never include
             in backups. GOALS.md §18e: path changed from "datastore/settings.preferences_pb"
             (Android's old Context.dataStore delegate convention) to "settings.preferences_pb"
             directly under filesDir, since the KMP-safe DataStore setup writes to a path we
             control directly. -->
        <exclude domain="file" path="settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>