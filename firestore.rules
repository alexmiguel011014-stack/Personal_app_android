rules_version = '2';

// Schema (see GOALS.md §4a, §7):
//   users/{uid}          - role ('ADM'|'TRAINER'|'STUDENT'), trainerId (STUDENT docs only).
//                           A linked STUDENT's full profile lives here (GOALS.md §7 "unify").
//   students/{studentId} - trainerId. Trainer-authored draft, pre-invite only.
//   invites/{code}        - trainerId, used, createdAt + copied draft fields.
//   workouts/{workoutId} - trainerId, studentId, status ('draft'|'assigned')
//   biometrics/{entryId} - trainerId, studentId
//   schedules/{scheduleId} - trainerId, studentId
//   workoutLogs/{logId}  - trainerId, studentId (written by the student, read by their trainer)
//   assessments/{id}     - trainerId, studentId, submittedAt, parQAnswersJson, goal, ... (GOALS.md
//                           §17: written by the student, append-only, read by their trainer)
//   trainerRequests/{uid} - email, createdAt. Self-written "please promote me" mailbox, doc ID is
//                           the requester's own uid; only an ADM can read/act on it (GOALS.md §5e).
//   payments/{studentId}_{YYYY-MM} - one monthly charge (GOALS.md §23c). Trainer-only.
//   billingPlans/{studentId}       - what to charge that student each month (GOALS.md §23c).
//                                    Trainer-only.
//
//   users/{uid} also carries the GOALS.md §17 flags a trainer grants a linked student:
//   canSelfAssess, canLogBiometrics (trainer-only), pendingAssessmentRequest (set by the trainer,
//   cleared by the student's assessment batch), lastAssessmentId (that batch's link). Web-only
//   flag, same rule: canAddSets — whether the student may add extra sets when logging a session
//   (off unless the trainer turns it on; a missing field reads as off).
//
//   Verified e-mail (GOALS.md §27): claiming an invite (creating or re-claiming users/{uid}) and
//   queueing trainerRequests/{uid} need request.auth.token.email_verified — see hasVerifiedEmail().

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function field(data, name) {
      return data.get(name, null);
    }

    function myRole() {
      return field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'role');
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'ADM';
    }

    // GOALS.md §27: the caller's address was confirmed by the link Firebase mailed to it. Firebase
    // only checks an address's shape, so without this an invented or mistyped one (teste@teste.com)
    // could become a student. Read from the ID token — no document read, so it costs nothing against
    // the per-request get() limit — and required only at the entry doors (claiming an invite,
    // queueing a trainer request): accounts that already have a profile keep working as they are.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    // The caller is the TRAINER who owns this record.
    function isOwningTrainer(trainerId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && request.auth.uid == trainerId &&
        field(user, 'role') == 'TRAINER' && field(user, 'accessStatus') != 'suspended';
    }

    // GOALS.md §23d: a student's own write can never result in a §17 permission their trainer
    // didn't grant. The self-update branch already froze these flags, but the invite claim (a
    // create, or the re-claim update) could arrive with them switched on.
    function grantsNoPermissions(data) {
      return data.get('canSelfAssess', false) == false &&
        data.get('canLogBiometrics', false) == false &&
        data.get('canAddSets', false) == false &&
        data.get('pendingAssessmentRequest', false) == false;
    }

    // users/{uid} — self-read, admin-managed writes. A user can edit their own
    // profile fields but can never change their own role or trainerId (no self-promotion).
    match /users/{uid} {
      // The owning trainer may also list/read their own linked students' docs (GOALS.md §13d
      // follow-up: the §7 "unify" model's Meus Alunos listener needs this to ever return
      // linked-account results, not just self-read/admin).
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isAdmin() || isOwningTrainer(field(resource.data, 'trainerId'))
      );
      // A self-registered student has no users/{uid} doc yet, so claiming an invite is their
      // first-ever write here (create, not update) — allowed only by presenting a currently
      // valid, unused invite minted by the trainerId being claimed.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        hasVerifiedEmail() &&
        request.resource.data.role == 'STUDENT' &&
        request.resource.data.trainerId ==
          get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.trainerId &&
        get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false &&
        // GOALS.md §23d: single-use for real. Checking only that the invite was unused let a client
        // create this doc without marking the invite, and the same code then worked again; the
        // same batch must now leave the invite used (AuthRepository.claimInvite's transaction
        // already does both writes together).
        getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true &&
        grantsNoPermissions(request.resource.data)
      );
      // Three writers:
      // 1. The owning trainer (GOALS.md §17c, and the fix for a pre-existing gap: before this,
      //    no branch let a trainer edit a linked student's profile at all, so EditStudentScreen's
      //    set(merge) on users/{uid} was silently PERMISSION_DENIED). Restricted to the profile
      //    fields TrainerRepository.updateUser writes plus the §17 permission/request flags —
      //    never role/trainerId/inviteCode.
      // 2. The student themselves: own profile fields only. role/trainerId immutable (the
      //    anti-self-promotion guarantee); canSelfAssess/canLogBiometrics immutable (trainer-
      //    granted, §17); pendingAssessmentRequest may only go true -> false, and only in the
      //    same batch that creates the assessment doc named by lastAssessmentId (existsAfter
      //    sees the batch's own writes) — a student can't just dismiss a request.
      // 3. The narrow re-claim exception (GOALS.md §13d): an account that already has a
      //    users/{uid} doc but is still an unclaimed STUDENT (trainerId null) may attach to a
      //    trainer for the first time via the same valid-unused-invite proof the create rule
      //    above requires. Any other existing role/trainerId (TRAINER, ADM, or already linked to
      //    a different trainer) stays blocked — that needs an explicit ADM decision.
      allow update: if isAdmin() || (
        isOwningTrainer(field(resource.data, 'trainerId')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'gender', 'phone', 'goal', 'experienceLevel', 'medicalNotes', 'trainingDays',
          'canSelfAssess', 'canLogBiometrics', 'canAddSets', 'pendingAssessmentRequest'
        ])
      ) || (
        isSignedIn() && request.auth.uid == uid &&
        (
          (
            field(request.resource.data, 'role') == field(resource.data, 'role') &&
            field(request.resource.data, 'trainerId') == field(resource.data, 'trainerId') &&
            field(request.resource.data, 'canSelfAssess') == field(resource.data, 'canSelfAssess') &&
            field(request.resource.data, 'canLogBiometrics') == field(resource.data, 'canLogBiometrics') &&
            // Trainer-granted too: without this line a student could switch canAddSets on for themselves.
            field(request.resource.data, 'canAddSets') == field(resource.data, 'canAddSets') &&
            field(request.resource.data, 'accessStatus') == field(resource.data, 'accessStatus') &&
            field(request.resource.data, 'suspendedAt') == field(resource.data, 'suspendedAt') &&
            field(request.resource.data, 'suspendedReason') == field(resource.data, 'suspendedReason') &&
            field(request.resource.data, 'createdBy') == field(resource.data, 'createdBy') &&
            field(request.resource.data, 'plan') == field(resource.data, 'plan') &&
            // GOALS.md §23d: the trainer's web dashboard reads both — inviteCode to drop the draft a
            // claim superseded, createdAt to size the adherence and "gone quiet" windows. A student
            // editing either could hide from their trainer's numbers.
            field(request.resource.data, 'inviteCode') == field(resource.data, 'inviteCode') &&
            field(request.resource.data, 'createdAt') == field(resource.data, 'createdAt') &&
            (
              field(request.resource.data, 'pendingAssessmentRequest') == field(resource.data, 'pendingAssessmentRequest') ||
              (
                field(resource.data, 'pendingAssessmentRequest') == true &&
                field(request.resource.data, 'pendingAssessmentRequest') == false &&
                // Created by this very batch (§23d): existsAfter alone also accepted pointing
                // lastAssessmentId at an older assessment, dismissing the request without
                // submitting anything.
                !exists(/databases/$(database)/documents/assessments/$(request.resource.data.lastAssessmentId)) &&
                existsAfter(/databases/$(database)/documents/assessments/$(request.resource.data.lastAssessmentId))
              )
            )
          ) ||
          (
            field(resource.data, 'role') == 'STUDENT' &&
            field(resource.data, 'trainerId') == null &&
            hasVerifiedEmail() &&
            request.resource.data.role == 'STUDENT' &&
            request.resource.data.trainerId ==
              get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.trainerId &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == false &&
            // Same two §23d conditions as the create rule above.
            getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.used == true &&
            grantsNoPermissions(request.resource.data)
          )
        )
      );
      // The owning trainer may also remove a linked student's account (symmetric with every
      // other collection here); non-STUDENT docs have no trainerId field so this never matches them.
      allow delete: if isAdmin() || isOwningTrainer(field(resource.data, 'trainerId'));
    }

    // invites/{code} — a short-lived, single-use claim token minted by a trainer so a student
    // can self-serve role=STUDENT + trainerId without a server (see GOALS.md §7).
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwningTrainer(request.resource.data.trainerId) && request.resource.data.used == false;
      // The claiming student (not the trainer) performs this write — only the used:false->true
      // transition is permitted, no other field (including trainerId) may change.
      allow update: if isSignedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.trainerId == resource.data.trainerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        // GOALS.md §23d: only as part of a claim — after the batch, the caller's own users doc must
        // name this invite. Otherwise anyone holding the link could burn it without using it, and
        // a /convite/<code> URL gets seen by more eyes (chat previews, browser history) than a
        // typed code did.
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode == code;
      allow delete: if isOwningTrainer(resource.data.trainerId);
    }

    // students/{studentId} — owned by trainerId; the linked student can read their own doc.
    match /students/{studentId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && request.auth.uid == studentId);
      allow create: if isOwningTrainer(request.resource.data.trainerId);
      allow update, delete: if isOwningTrainer(resource.data.trainerId);
    }

    // workouts/{workoutId} — trainer manages; student reads only their own assigned fichas.
    match /workouts/{workoutId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid && resource.data.status == 'assigned');
      allow create: if isOwningTrainer(request.resource.data.trainerId);
      allow update, delete: if isOwningTrainer(resource.data.trainerId);
    }

    // biometrics/{entryId} — trainer manages; student reads their own entries, and may create
    // their own once the trainer set canLogBiometrics on their profile (GOALS.md §17c). The
    // trainerId on the entry must be the student's own trainer, as with workoutLogs.
    match /biometrics/{entryId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isOwningTrainer(request.resource.data.trainerId) || (
        isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'canLogBiometrics') == true &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId')
      );
      allow update, delete: if isOwningTrainer(resource.data.trainerId);
    }

    // schedules/{scheduleId} — trainer manages; student reads their own appointments.
    match /schedules/{scheduleId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isOwningTrainer(request.resource.data.trainerId);
      allow update, delete: if isOwningTrainer(resource.data.trainerId);
    }

    // workoutLogs/{logId} — the student logs their own performed sets; the owning
    // trainer reads them for the evolution report. trainerId must match the
    // student's own users/{uid}.trainerId so a student can't attribute a log to
    // a trainer they don't belong to.
    match /workoutLogs/{logId} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
      // GOALS.md §23d: an update must also start from the caller's own log. Checking only the new
      // studentId let one student overwrite another's log and re-attribute it to themselves.
      allow update: if isSignedIn() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // assessments/{id} — GOALS.md §17: the student's self-assessment history. Created by the
    // student only while their trainer has granted canSelfAssess, attributed to that trainer;
    // read by the owning trainer or the student. Append-only: no update/delete, so history can't
    // be rewritten from a client.
    match /assessments/{id} {
      allow read: if isOwningTrainer(resource.data.trainerId) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'canSelfAssess') == true &&
        request.resource.data.trainerId ==
          field(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'trainerId');
    }

    // trainerRequests/{uid} — a self-registered STUDENT asks to become a TRAINER; only the ADM
    // can see the queue. Acceptance/rejection are just isAdmin() writes (users/{uid}.role update,
    // or deleting this doc) — this collection carries zero privilege on its own, it's a mailbox.
    match /trainerRequests/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // GOALS.md §27: only from a confirmed address — the ADM's queue is not a place for invented ones.
      allow create: if isSignedIn() && request.auth.uid == uid && hasVerifiedEmail();
      allow delete: if isAdmin();
    }

    // payments/{paymentId} — GOALS.md §23c/§23d: mensalidades, level 1 (recorded by hand; no money
    // moves). Trainer-only: a student never reads these, not even their own — the trainer's
    // decision, 2026-09-22. The id is {studentId}_{YYYY-MM} of the charge's dueDate, which is what
    // makes generating a month's charges idempotent; these rules hold that invariant. The shape is
    // validated because a malformed charge (float cents, a missing paidAt) silently breaks every
    // query that reads it back — see web/src/domain/payments.ts for the model.
    match /payments/{paymentId} {
      function yearMonthOf(date) {
        let parts = date.split('-');
        return parts[0] + '-' + parts[1];
      }

      // Every field always present — `where('paidAt', '==', null)` doesn't match a document that
      // lacks the field. No `id` field: the document id carries it, as in FirestoreMappers.kt.
      function isPayment(d) {
        let fields = ['trainerId', 'studentId', 'amountCents', 'currency', 'dueDate', 'paidAt',
                      'method', 'source', 'externalId', 'note', 'createdAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId is string && d.studentId is string &&
          d.amountCents is int && d.amountCents > 0 &&
          d.currency == 'BRL' &&
          d.dueDate is string &&
          d.dueDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
          (d.paidAt == null || d.paidAt is int) &&
          (d.method == null || d.method in ['pix', 'cash', 'card', 'transfer', 'other']) &&
          d.source in ['manual', 'gateway'] &&
          (d.externalId == null || d.externalId is string) &&
          (d.note == null || (d.note is string && d.note.size() <= 500)) &&
          d.createdAt is int;
      }

      // A charge that doesn't exist yet has no resource.data to check — and that is exactly the
      // read create-if-absent makes (ensureMonthlyCharges reads inside a transaction before
      // creating). For a missing charge, ownership comes from the plan it would be generated from:
      // the id starts with the studentId, and billingPlans/{studentId} names the trainer. No plan,
      // no answer — so nobody can probe other trainers' students.
      allow read: if resource == null
        ? isOwningTrainer(get(/databases/$(database)/documents/billingPlans/$(paymentId.split('_')[0])).data.trainerId)
        : isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isPayment(request.resource.data) &&
        paymentId == request.resource.data.studentId + '_' + yearMonthOf(request.resource.data.dueDate) &&
        // Clients only ever write manual charges. A level-2 payment gateway would write through
        // the Admin SDK, which bypasses these rules — no client needs to create a gateway charge.
        request.resource.data.source == 'manual' &&
        request.resource.data.externalId == null;
      // Editable: the amount, the due day within the same month (the id encodes the month), and
      // settlement — including undoing a mistaken "paid". A gateway-owned charge is the
      // gateway's to change, never the client's.
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        resource.data.source == 'manual' &&
        isPayment(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['amountCents', 'dueDate', 'paidAt', 'method', 'note']) &&
        yearMonthOf(request.resource.data.dueDate) == yearMonthOf(resource.data.dueDate);
      allow delete: if isOwningTrainer(resource.data.trainerId) && resource.data.source == 'manual';
    }

    // billingPlans/{studentId} — GOALS.md §23c: the amount and due day a student's monthly charge
    // is generated from. Trainer-only for the same reason as payments — and the reason this isn't
    // fields on users/{uid}: rules are per document, not per field, and a student reads their own
    // users doc.
    match /billingPlans/{studentId} {
      function isBillingPlan(d) {
        let fields = ['studentId', 'trainerId', 'amountCents', 'currency', 'dueDay', 'active', 'createdAt'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.studentId is string && d.trainerId is string &&
          d.amountCents is int && d.amountCents > 0 &&
          d.currency == 'BRL' &&
          d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31 &&
          d.active is bool &&
          d.createdAt is int;
      }

      allow read, delete: if isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isBillingPlan(request.resource.data) &&
        request.resource.data.studentId == studentId;
      allow update: if isOwningTrainer(resource.data.trainerId) &&
        isBillingPlan(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountCents', 'dueDay', 'active']);
    }

    // §26c summaries are self-reported by the owning trainer. Their exact shapes are allow-listed
    // so an ADM sees bounded, non-student data and cannot manufacture another trainer's metrics.
    match /trainerStats/{trainerId} {
      function isTrainerStats(d) {
        let fields = ['trainerId', 'updatedAt', 'lastSeenAt', 'students', 'sessions7d', 'adherence28d',
                      'quiet', 'pendingAssessments', 'billing'];
        let studentFields = ['total', 'linked', 'pending'];
        let billingFields = ['month', 'activePlans', 'planCents', 'expectedCents', 'receivedCents', 'overdueCents'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId == trainerId && d.trainerId is string && d.updatedAt is int &&
          d.lastSeenAt is int && d.students is map && d.students.keys().hasAll(studentFields) &&
          d.students.keys().hasOnly(studentFields) && d.students.total is int && d.students.total >= 0 &&
          d.students.linked is int && d.students.linked >= 0 && d.students.pending is int && d.students.pending >= 0 &&
          d.sessions7d is int && d.sessions7d >= 0 &&
          (d.adherence28d == null || (d.adherence28d is number && d.adherence28d >= 0 && d.adherence28d <= 1)) &&
          d.quiet is int && d.quiet >= 0 && d.pendingAssessments is int && d.pendingAssessments >= 0 &&
          d.billing is map && d.billing.keys().hasAll(billingFields) && d.billing.keys().hasOnly(billingFields) &&
          d.billing.month is string && d.billing.month.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
          d.billing.activePlans is int && d.billing.activePlans >= 0 &&
          d.billing.planCents is int && d.billing.planCents >= 0 &&
          d.billing.expectedCents is int && d.billing.expectedCents >= 0 &&
          d.billing.receivedCents is int && d.billing.receivedCents >= 0 &&
          d.billing.overdueCents is int && d.billing.overdueCents >= 0;
      }

      allow read: if isAdmin() || isOwningTrainer(trainerId);
      allow create, update: if isOwningTrainer(trainerId) && isTrainerStats(request.resource.data);
      allow delete: if isAdmin();
    }

    match /trainerActivity/{activityId} {
      function allowedActions() {
        return ['login', 'studentCreated', 'inviteGenerated', 'fichaSaved', 'geminiGenerated',
                'chargePaid', 'bookingAdded', 'measurementAdded', 'assessmentRequested'];
      }

      function isTrainerActivity(d) {
        let fields = ['trainerId', 'month', 'updatedAt', 'actions', 'activeDays'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) &&
          d.trainerId is string && d.month is string && d.month.matches('[0-9]{4}-(0[1-9]|1[0-2])') &&
          activityId == d.trainerId + '_' + d.month && d.updatedAt is int &&
          d.actions is map && d.actions.keys().hasOnly(allowedActions());
      }

      function actionsAreNonnegative(actions) {
        return (!('login' in actions) || (actions.login is int && actions.login >= 0)) &&
          (!('studentCreated' in actions) || (actions.studentCreated is int && actions.studentCreated >= 0)) &&
          (!('inviteGenerated' in actions) || (actions.inviteGenerated is int && actions.inviteGenerated >= 0)) &&
          (!('fichaSaved' in actions) || (actions.fichaSaved is int && actions.fichaSaved >= 0)) &&
          (!('geminiGenerated' in actions) || (actions.geminiGenerated is int && actions.geminiGenerated >= 0)) &&
          (!('chargePaid' in actions) || (actions.chargePaid is int && actions.chargePaid >= 0)) &&
          (!('bookingAdded' in actions) || (actions.bookingAdded is int && actions.bookingAdded >= 0)) &&
          (!('measurementAdded' in actions) || (actions.measurementAdded is int && actions.measurementAdded >= 0)) &&
          (!('assessmentRequested' in actions) || (actions.assessmentRequested is int && actions.assessmentRequested >= 0));
      }

      function actionsDoNotDecrease(next, previous) {
        return (('login' in next) ? next.login >= previous.get('login', 0) : previous.get('login', 0) == 0) &&
          (('studentCreated' in next) ? next.studentCreated >= previous.get('studentCreated', 0) : previous.get('studentCreated', 0) == 0) &&
          (('inviteGenerated' in next) ? next.inviteGenerated >= previous.get('inviteGenerated', 0) : previous.get('inviteGenerated', 0) == 0) &&
          (('fichaSaved' in next) ? next.fichaSaved >= previous.get('fichaSaved', 0) : previous.get('fichaSaved', 0) == 0) &&
          (('geminiGenerated' in next) ? next.geminiGenerated >= previous.get('geminiGenerated', 0) : previous.get('geminiGenerated', 0) == 0) &&
          (('chargePaid' in next) ? next.chargePaid >= previous.get('chargePaid', 0) : previous.get('chargePaid', 0) == 0) &&
          (('bookingAdded' in next) ? next.bookingAdded >= previous.get('bookingAdded', 0) : previous.get('bookingAdded', 0) == 0) &&
          (('measurementAdded' in next) ? next.measurementAdded >= previous.get('measurementAdded', 0) : previous.get('measurementAdded', 0) == 0) &&
          (('assessmentRequested' in next) ? next.assessmentRequested >= previous.get('assessmentRequested', 0) : previous.get('assessmentRequested', 0) == 0);
      }

      function validDays(days) {
        return days is list && days.size() <= 31 &&
          (days.size() < 1 || days[0] is string) && (days.size() < 2 || days[1] is string) &&
          (days.size() < 3 || days[2] is string) && (days.size() < 4 || days[3] is string) &&
          (days.size() < 5 || days[4] is string) && (days.size() < 6 || days[5] is string) &&
          (days.size() < 7 || days[6] is string) && (days.size() < 8 || days[7] is string) &&
          (days.size() < 9 || days[8] is string) && (days.size() < 10 || days[9] is string) &&
          (days.size() < 11 || days[10] is string) && (days.size() < 12 || days[11] is string) &&
          (days.size() < 13 || days[12] is string) && (days.size() < 14 || days[13] is string) &&
          (days.size() < 15 || days[14] is string) && (days.size() < 16 || days[15] is string) &&
          (days.size() < 17 || days[16] is string) && (days.size() < 18 || days[17] is string) &&
          (days.size() < 19 || days[18] is string) && (days.size() < 20 || days[19] is string) &&
          (days.size() < 21 || days[20] is string) && (days.size() < 22 || days[21] is string) &&
          (days.size() < 23 || days[22] is string) && (days.size() < 24 || days[23] is string) &&
          (days.size() < 25 || days[24] is string) && (days.size() < 26 || days[25] is string) &&
          (days.size() < 27 || days[26] is string) && (days.size() < 28 || days[27] is string) &&
          (days.size() < 29 || days[28] is string) && (days.size() < 30 || days[29] is string) &&
          (days.size() < 31 || days[30] is string);
      }

      allow read: if isAdmin() || isOwningTrainer(resource.data.trainerId);
      allow create: if isOwningTrainer(request.resource.data.trainerId) &&
        isTrainerActivity(request.resource.data) && actionsAreNonnegative(request.resource.data.actions) && validDays(request.resource.data.activeDays);
      allow update: if isOwningTrainer(request.resource.data.trainerId) &&
        isTrainerActivity(request.resource.data) && resource.data.trainerId == request.resource.data.trainerId &&
        actionsAreNonnegative(request.resource.data.actions) && actionsDoNotDecrease(request.resource.data.actions, resource.data.actions) &&
        validDays(request.resource.data.activeDays);
      allow delete: if isAdmin();
    }

    match /adminAudit/{auditId} {
      function validAudit(d) {
        let fields = ['at', 'adminUid', 'action', 'targetUid', 'note'];
        return d.keys().hasAll(fields) && d.keys().hasOnly(fields) && d.at is int &&
          d.adminUid == request.auth.uid && d.action in ['trainer.create', 'trainer.suspend', 'trainer.reactivate',
          'trainer.promote', 'request.reject', 'trainer.resetEmail'] && d.targetUid is string &&
          d.note is string && d.note.size() <= 200;
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && validAudit(request.resource.data);
    }

    // Everything else: denied by default (no catch-all match).
  }
}
