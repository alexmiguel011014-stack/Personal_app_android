    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.31.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
