# iOS app shell (GOALS.md §18j) — XcodeGen-generated project, CocoaPods-installed pods, and
# build output are all reproducible from project.yml/Podfile + :shared, never hand-edited.
/iosApp/*.xcodeproj/
/iosApp/*.xcworkspace/
/iosApp/Pods/
/iosApp/Podfile.lock
/iosApp/build/
/shared/*.podspec
