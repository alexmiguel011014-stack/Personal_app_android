import kotlin.String;
import kotlin.Boolean;
import kotlin.collections.List;

CREATE TABLE users (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    role TEXT NOT NULL,
    gender TEXT NOT NULL,
    phone TEXT NOT NULL,
    goal TEXT NOT NULL,
    experienceLevel TEXT NOT NULL,
    medicalNotes TEXT NOT NULL,
    trainingDays TEXT AS List<String> NOT NULL,
    createdAt INTEGER NOT NULL,
    linked INTEGER AS Boolean NOT NULL
);

insertUser:
INSERT OR REPLACE INTO users(id, name, role, gender, phone, goal, experienceLevel, medicalNotes, trainingDays, createdAt, linked)
VALUES (:id, :name, :role, :gender, :phone, :goal, :experienceLevel, :medicalNotes, :trainingDays, :createdAt, :linked);

updateUser:
UPDATE users SET
    name = :name, role = :role, gender = :gender, phone = :phone, goal = :goal,
    experienceLevel = :experienceLevel, medicalNotes = :medicalNotes,
    trainingDays = :trainingDays, createdAt = :createdAt, linked = :linked
WHERE id = :id;

deleteUser:
DELETE FROM users WHERE id = :id;

getStudents:
SELECT * FROM users WHERE role = 'student';

getUserById:
SELECT * FROM users WHERE id = :id;
